          </statement>
          </exercise>

        <exercise xml:id="ex-Rogawski-12-01-3457">
          <introduction>
            <p>
              Find parametric equations for the following curves.
            </p>
          </introduction>
          <task xml:id="ex-Rogawski-12-01-34">
