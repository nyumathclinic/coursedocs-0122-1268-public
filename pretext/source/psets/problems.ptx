        </exercise>

        <exercise xml:id="ex-Rogawski-12-01-64">
          <statement>
            <p>A <quantity><mag>10</mag><unit base="foot" /></quantity> ladder slides down a wall as its bottom B is pulled away from the wall (<xref ref="ex-Rogawski-12-01-64-fig" />). 
              Using the angle <m>\theta</m> as parameter, find the parametric equations for the path followed by:
              <ol>
                <li>the top of the ladder <m>A</m></li>
                <li>the bottom of the ladder <m>B</m></li>
                <li>the point <m>P</m> located <quantity><mag>4</mag><unit base="foot" /></quantity> from the top of the ladder</li>
              </ol>
              Show that <m>P</m> describes an ellipse.
            </p>
            <figure xml:id="ex-Rogawski-12-01-64-fig">
              <caption>See <xref ref="ex-Rogawski-12-01-64" /></caption>
              <image>
                <ns2:prefigure label="ex-Rogawski-12-01-64-prefig">
                  <ns2:diagram dimensions="(300,300)" margins="5">
                    <ns2:definition>th = 0.8</ns2:definition>
                    <ns2:definition>xP = 4*cos(th)</ns2:definition>
                    <ns2:definition>yP = 6*sin(th)</ns2:definition>
                    <ns2:definition>xB = 10*cos(th)</ns2:definition>
                    <ns2:definition>yA = 10*sin(th)</ns2:definition>
                    <ns2:definition>ellipse(t) = (4*cos(t),6*sin(t))</ns2:definition>
                    <ns2:definition>NyuViolet="#57068c"</ns2:definition>
                    <ns2:definition>UltraViolet="#8900e1"</ns2:definition>
                    <ns2:definition>MediumViolet1="#702b9d"</ns2:definition>
                    <ns2:definition>MediumViolet2="#7b5aa6"</ns2:definition>
                    <ns2:definition>LightViolet1="#ab82c5"</ns2:definition>
                    <ns2:definition>LightViolet2="#eee6f3"</ns2:definition>
                    <ns2:definition>Magenta="#fb0f78"</ns2:definition>
                    <ns2:definition>DarkGray="#404040"</ns2:definition>
                    <ns2:definition>MediumGray2="#b8b8b8"</ns2:definition>
                    <ns2:coordinates bbox="(-1,-1,10,10)">
                      <ns2:axes xlabel="x" ylabel="y" decorations="no" />
                      <ns2:parametric-curve function="ellipse" domain="(0,pi/2)" stroke="UltraViolet" />
                      <ns2:polygon points="((0,yA),(xB,0))" closed="no" stroke="NyuViolet" />
                      <ns2:polygon points="((xP,0),(xP,yP))" closed="no" stroke="MediumGray2" />
                      <ns2:polygon points="((0,yP),(xP,yP))" closed="no" stroke="MediumGray2" />
                      <ns2:point p="(0,yA)" stroke="NyuViolet" fill="NyuViolet" size="2" alignment="nw"><ns2:m>A</ns2:m></ns2:point>
                      <ns2:point p="(xB,0)" stroke="NyuViolet" fill="NyuViolet" size="2" alignment="s"><ns2:m>B</ns2:m></ns2:point>
                      <ns2:point p="(xP,yP)" stroke="NyuViolet" fill="NyuViolet" size="2"><ns2:m>P=(x,y)</ns2:m></ns2:point>
                      <ns2:label anchor="(xP/2-0.2,(yP+yA)/2)" alignment="ne"><ns2:m>4</ns2:m></ns2:label>
                      <ns2:label anchor="((xP+xB)/2,(yP)/2)" alignment="ne"><ns2:m>6</ns2:m></ns2:label>
                      <ns2:angle-marker points="((0,yA),(xB,0),(xB-1,0))" thickness="1">
                        <ns2:m>\theta</ns2:m>
                      </ns2:angle-marker>
                      <ns2:line p1="(xB,0.25)" p2="(xB+1,0.25)" stroke="Magenta" arrows="1" />
                      <ns2:line p1="(-0.25,yA)" p2="(-0.25,yA-1)" stroke="Magenta" arrows="1" />
                    </ns2:coordinates>
                  </ns2:diagram>
                </ns2:prefigure>
              </image>
            </figure>
          </statement>
          </exercise>

        <exercise xml:id="ex-parametric-derivatives">
          <statement>
            <p> A curve is defined by the parametric equations <m>x(t) = t^2+1</m> and <m>y(t)=t^3-1</m>.
              Find <m>\frac{dy}{dx}</m> and <m>\frac{d^2y}{dx^2}</m>, in terms of <m>t</m>, and also
              at the point <m>(2,0)</m>. </p>
          </statement>
          </exercise>

        <exercise xml:id="ex-parametric-arc-length">
          <statement>
            <p> Find the length of the curve given by the parametric equations <m>x=t^3</m> and <m>
              y=t^2</m> for <m>0 \le t \le 1</m>. </p>
          </statement>
          </exercise>

      <exercise xml:id="ex-Larson-10-03-84">
        <introduction>
          <p>
            The <url href="https://en.wikipedia.org/wiki/Deltoid_curve"><em>deltoid curve</em></url>
            is formed by a point on a circle of radius <m>a</m> as it rolls around the inside of a circle
            of radius <m>3a</m>. It has parametric equations:
            <md>
              <mrow> x &amp;= 2a \cos t + a \cos 2t</mrow>
              <mrow> y &amp;= 2a \sin t - a \sin 2t</mrow>
            </md>
            over the interval <m> 0\leq t \leq 2\pi</m>.
            See <xref ref="ex-Larson-10-03-84-fig" />.
          </p>
            <figure xml:id="ex-Larson-10-03-84-fig">
              <caption>See <xref ref="ex-Larson-10-03-84" /></caption>
              <image>
                <ns2:prefigure label="ex-Larson-10-03-84-prefig">
                  <ns2:diagram dimensions="(300,300)" margins="5">
                    <ns2:definition>NyuViolet="#57068c"</ns2:definition>
                    <ns2:definition>UltraViolet="#8900e1"</ns2:definition>
                    <ns2:definition>MediumViolet1="#702b9d"</ns2:definition>
                    <ns2:definition>MediumViolet2="#7b5aa6"</ns2:definition>
                    <ns2:definition>LightViolet1="#ab82c5"</ns2:definition>
                    <ns2:definition>LightViolet2="#eee6f3"</ns2:definition>
                    <ns2:definition>Magenta="#fb0f78"</ns2:definition>
                    <ns2:definition>DarkGray="#404040"</ns2:definition>
                    <ns2:definition>MediumGray2="#b8b8b8"</ns2:definition>
                    <ns2:definition>a=1</ns2:definition>
                    <ns2:definition>c(t) = (2*a*cos(t)+a*cos(2*t),2*a*sin(t)-a*sin(2*t))</ns2:definition>
                    <ns2:coordinates bbox="(-4,-4,4,4)">
                      <ns2:parametric-curve function="c" domain="(0,2*pi)" stroke="UltraViolet" fill="LightViolet1" arrows="1" arrow-location="0.85*2*pi" />
                      <ns2:axes xlabel="x" ylabel="y" decorations="no" hticks="(a,a,3*a)" />
                      <ns2:label anchor="(a,0)" alignment="s"><ns2:m>a</ns2:m></ns2:label>
                    </ns2:coordinates>
                  </ns2:diagram>
                </ns2:prefigure>
              </image>
            </figure>
        </introduction>
        <task>
          <statement>
            <p>
              Show that the area enclosed by the deltoid curve is equal to
              <md>
                A = -2 \int_0^\pi y(t) x'(t) \,dt
              </md>.
            </p>
          </statement>
          </task>
        <task>
          <statement>
            <p>
              Evaluate the expression in (a) to find the area.
            </p>
          </statement>
          </task>
      </exercise>

