<?xml version='1.0' encoding='UTF-8'?>
<pretext xmlns:ns0="http://www.w3.org/2001/XInclude">
  <ns0:include href="../docinfo.ptx" />
  <article>
    
    <worksheet xml:id="ws-polar-calculus">
      <title>Worksheet for Section 9.4: Integration with Polar Coordinates</title>

      <objectives>
        <ul>
          <li>
            <p>
              Find the area of a circular sector.
            </p>
          </li>

          <li>
            <p>
              Find the area of a radially simple polar region.
            </p>
          </li>

          <li>
            <p>
              Find the length of a polar curve.
            </p>
          </li>
        </ul>
      </objectives>


      <page>
        <exercise workspace="1in" xml:id="ex-polar-calculus-1">
          <statement>
            <p> Find the area enclosed by the cardioid with equation <m>r = 1 - \sin{\theta}</m>. </p>
          </statement>

          </exercise>

        <exercise workspace="1in" xml:id="ex-polar-calculus-2">
          <statement>
            <p> Find the area inside the limaçon (with loop) given by the equation <m>r = 1 -
              2\sin{\theta}</m>. </p>
          </statement>

          </exercise>

        <exercise workspace="1in" xml:id="ex-polar-calculus-4">
          <statement>
            <p> Find the area of the sector of the circle <m>r=4</m> for <m>0 \leq \theta \leq
                \frac{\pi}{3}</m>. </p>
          </statement>

          </exercise>

      </page>
      <page>
        <exercise workspace="1in" xml:id="ex-polar-calculus-3">
          <statement>
            <p> Find the length of the curve with equation <m>r=e^{2\theta}</m>, <m>0 \leq
                \theta\leq 2\pi</m>. </p>

          </statement>

          </exercise>

        <exercise workspace="1in" xml:id="ex-polar-calculus-5">
          <statement>
            <p> Find the length of the curve <m>r=2\sin{\theta}</m> for <m>0\leq\theta\leq\pi</m>. </p>
          </statement>

          </exercise>

      </page>
    </worksheet>
  </article>
</pretext>